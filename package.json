{
  "name": "dsh-compaction-policy",
  "version": "0.1.0",
  "description": "Per-route compaction trigger policy for DeepSeek Harness: gates the preset-plane compaction engine so long-window routes stop compacting at ~56%. DeepSeek Harness 上下文压缩触发点插件。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README-zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/policy.test.js tests/instrument.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-token-meter": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": ">=18.2.0 <20.0.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-agent-preset-registry": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/dsh-token-meter": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "react": { "optional": true }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "MIT"
}
